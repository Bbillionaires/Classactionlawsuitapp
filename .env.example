# CourtListener REST API token (server-side only — never expose to the client).
# Get one at https://www.courtlistener.com/help/api/rest/#authentication
COURTLISTENER_API_TOKEN=

# Base URL for the CourtListener REST API. Override only for testing against a different environment.
COURTLISTENER_API_BASE_URL=https://www.courtlistener.com/api/rest/v4

# Postgres connection string (same database the settlement-discovery
# worker uses — see worker/.env.example). Required for member accounts,
# claim-filing authorization, and document uploads; the settlement
# read-only features degrade gracefully without it, but auth does not.
DATABASE_URL=

# Any long random string — signs member session cookies (JWT). Required
# for sign-up/login to work. Generate with e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Vercel Blob read/write token, for private (never publicly-URLed)
# storage of member-uploaded government ID photos and claim proof
# documents. Create a Blob store in the Vercel dashboard to get one.
BLOB_READ_WRITE_TOKEN=

# Resend — used to email members (welcome email). Requires a verified
# sending domain in Resend. Both optional: email sending is a no-op when
# either is unset. (The discovery worker sends saved-search alert emails
# from the same Resend account/domain — see worker/.env.example — but
# configures its own copy of these two vars, since it's a separately
# deployed process.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Postgres connection string (Railway's Postgres service — the public TCP
# proxy URL if this worker runs outside Railway's private network, or the
# private `${{Postgres.DATABASE_URL}}` reference if it runs inside the
# same Railway project).
DATABASE_URL=postgresql://user:password@host:port/settlements

# Same CourtListener token used by the main app. Shared 5 req/min budget —
# see courtlistener.ts for the throttling this worker applies so it never
# starves real site visitors.
COURTLISTENER_API_TOKEN=
COURTLISTENER_API_BASE_URL=https://www.courtlistener.com/api/rest/v4

# How many dockets / documents to scan per run. Keep these small — see
# courtlistener.ts for why.
DOCKETS_PER_RUN=5
MAX_DOCUMENTS_PER_RUN=5

# How many Top Class Actions "open settlement" leads to check per run —
# see aggregator.ts / discoverFromAggregator.ts. Each lead costs one
# extra CourtListener call (docket cross-reference), so this also eats
# into the same shared rate-limit budget.
AGGREGATOR_LEADS_PER_RUN=3

# How many members' saved searches (account-tied, src/lib/members/schema.ts
# in the main app) to re-check per run for new matching cases — see
# savedSearchAlerts.ts. Each costs one more CourtListener call, same
# shared budget as everything else above. Rotates through searches
# oldest-checked-first, so all of them eventually get checked even if
# there are more than this per run.
SAVED_SEARCH_ALERTS_PER_RUN=3

# Both optional, same as the main app's: email alerting is a no-op when
# either is unset. See email.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Used to build the link in an alert email back to the case page.
# Defaults to the production site if unset.
SITE_URL=https://www.classactionpayouts.com
